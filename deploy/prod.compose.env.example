# Variabel untuk docker-compose.prod.yml. Salin jadi ./.env di root repo pada mesin deploy:
#   cp deploy/prod.compose.env.example .env && chmod 600 .env
#
# File ini hanya berisi konfigurasi compose. Rahasia aplikasi (BOT_TOKEN, kredensial Google,
# SUPABASE_KEY, dst.) tinggal di file terpisah yang ditunjuk BACKEND_ENV_FILE, di luar repo.

COMPOSE_PROJECT_NAME=wknd-tele-bot

# File .env aplikasi, di luar folder repo supaya tidak pernah ikut ter-commit.
BACKEND_ENV_FILE=$HOME/.config/wknd-tele-bot/backend.env

# Password root MySQL. Harus sama dengan yang dipakai di DATABASE_URL pada BACKEND_ENV_FILE.
# Buat yang acak: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tele_sso
DATA_VOLUME_NAME=wknd-tele-bot-data

# Port loopback untuk health check / debug dari dalam server; ganti kalau bentrok.
BACKEND_HOST_PORT=3102

CLOUDFLARED_CONFIG_FILE=$HOME/apps/wknd-tele-bot/deploy/cloudflared.prod.yml
CLOUDFLARED_CREDENTIALS_FILE=$HOME/.cloudflared/472d3a03-d2e7-41f1-8662-7e9df72179bb.json
# UID:GID pemilik CLOUDFLARED_CREDENTIALS_FILE di host deploy (`id -u`:`id -g`).
CLOUDFLARED_USER=1000:1000
