# Telegram
BOT_TOKEN=your_telegram_bot_token
BOT_MODE=polling
WEBHOOK_DOMAIN=https://your-domain.com

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Database
DATABASE_URL=mysql://user:password@localhost:3306/tele_sso

# App
PORT=3000
JWT_SECRET=your_jwt_secret_for_state_tokens
FRONTEND_URL=http://localhost:8080

# Akses
# Domain email yang boleh menautkan akun Google ke bot.
# Pisahkan dengan koma bila lebih dari satu, mis. weekendinc.com,contoh.co.id
ALLOWED_EMAIL_DOMAINS=weekendinc.com

# Kunci enkripsi token OAuth di database, 32 byte base64. Buat sekali dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Mengganti kunci membuat token lama tidak terbaca; user tinggal /login ulang.
TOKEN_ENCRYPTION_KEY=

# Opsional: batas permintaan per menit per IP untuk endpoint /auth (default 10)
AUTH_RATE_LIMIT=10

# Supabase
SUPABASE_KEY=your_supabase_anon_key