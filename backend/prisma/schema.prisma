// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  telegramId   BigInt         @id @map("telegram_id")
  googleEmail  String         @unique @map("google_email") @db.VarChar(255)
  googleSub    String         @unique @map("google_sub") @db.VarChar(255)
  accessToken  String?        @map("access_token") @db.Text
  refreshToken String?        @map("refresh_token") @db.Text
  tokenExpiry  DateTime?      @map("token_expiry")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@map("users")
}

model Attendance {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @map("telegram_id")
  date       DateTime  @map("date") @db.Date
  checkIn    DateTime  @map("check_in")
  checkOut   DateTime? @map("check_out")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([telegramId, date])
  @@index([telegramId])
  @@map("attendances")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  employeeNik String   @map("employee_nik") @db.VarChar(50)
  jobTitle    String   @map("job_title") @db.VarChar(255)
  name        String   @map("name") @db.VarChar(255)
  projectName String   @map("project_name") @db.VarChar(255)
  date        DateTime @map("date") @db.Date

  @@index([employeeNik])
  @@index([date])
  @@index([name])
  @@index([employeeNik, date])
  @@map("schedules")
}

model UserSchedule {
  id          Int    @id @default(autoincrement())
  telegramId  BigInt @unique @map("telegram_id")
  employeeNik String @map("employee_nik") @db.VarChar(50)

  @@index([employeeNik])
  @@map("user_schedules")
}

/// Antrean pekerjaan tertunda — sekarang hanya dipakai reminder check-out berantai.
///
/// Disimpan di database, bukan `setTimeout`, karena proses ini di-restart tiap deploy dan
/// timer di memori hilang tanpa jejak beserta reminder orang yang sudah check-in.
model ScheduledJob {
  id           Int      @id @default(autoincrement())
  type         String   @map("type") @db.VarChar(50)
  telegramId   BigInt   @map("telegram_id")
  attendanceId Int      @map("attendance_id")
  runAt        DateTime @map("run_at")
  status       String   @map("status") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([status, runAt])
  @@index([attendanceId])
  @@map("scheduled_jobs")
}

/// Hari libur, dikelola manual lewat /manage_holiday.
///
/// `year = 0` berarti berulang tiap tahun (17 Agustus), selain itu berlaku sekali saja
/// (Idul Fitri, cuti bersama — tanggalnya bergeser tiap tahun).
///
/// Penanda "berulang" sengaja memakai 0, bukan NULL: MySQL menganggap tiap NULL sebagai
/// nilai yang berbeda di unique index, sehingga dua entri 17 Agustus berulang akan
/// sama-sama lolos dan constraint di bawah jadi tidak berarti.
model Holiday {
  id    Int    @id @default(autoincrement())
  year  Int    @map("year")
  month Int    @map("month")
  day   Int    @map("day")
  label String @map("label") @db.VarChar(255)

  @@unique([year, month, day])
  @@index([month, day])
  @@map("holidays")
}
